# ============================================================
#  Variables de Entorno - Sistema de Control de Gastos
# ============================================================
#  Copia este archivo como .env y ajusta los valores
# ============================================================

# — Selección de Backend —
# postgresql (default, producción) | mysql (XAMPP)
DB_BACKEND=postgresql

# — PostgreSQL (producción) —
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=gastos_db
PG_USER=postgres
PG_PASSWORD=

# — MySQL/MariaDB (XAMPP) —
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gastos_db
MYSQL_USER=root
MYSQL_PASSWORD=

# — Flask —
SECRET_KEY=cambia-esto-en-produccion

# — Autenticación JWT (ISO/IEC 27001) —
# Modo: "jwt" (nuevo, stateless) o "session" (legacy, cookies)
AUTH_MODE=jwt
# Genera una clave con: python -c "from api.jwt_auth import generate_jwt_secret; print(generate_jwt_secret())"
JWT_SECRET_KEY=cambia-esto-en-produccion-genera-una-clave-de-64-hex
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# — Cifrado AES-256 (ISO/IEC 27001) —
# Genera una clave con: python -c "from db.crypto import generate_master_key; print(generate_master_key())"
AES_MASTER_KEY=cambia-esto-en-produccion-genera-una-clave-de-64-hex
AES_KEY_SALT=ControlCash_AES256_Salt_v1_2026
# Activar cifrado de datos sensibles (descripcion de movimientos)
ENCRYPT_SENSITIVE_DATA=false

# — NVIDIA NIM (IA) —
# NVIDIA_API_KEY=nvapi-xxx
