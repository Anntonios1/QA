# PostgreSQL
PG_DATABASE=gastos_db
PG_USER=controlcash
PG_PASSWORD=change-this-strong-password

# App binding (internal)
APP_PORT=5055

# Flask / API
SECRET_KEY=change-this-secret-key
AUTH_MODE=jwt

# JWT
JWT_SECRET_KEY=change-this-64-hex-jwt-key
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# AES-256
AES_MASTER_KEY=change-this-64-hex-aes-key
AES_KEY_SALT=ControlCash_AES256_Salt_v1_2026
ENCRYPT_SENSITIVE_DATA=false

# Optional AI
NVIDIA_API_KEY=

# Optional Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@controlcash.app